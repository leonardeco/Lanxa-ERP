# ══════════════════════════════════════════════════════
# Super Ozono Global ERP — PC Servidor (LAN, sin Docker)
# Copiar este archivo como backend/.env en el PC servidor
# Reemplazar 192.168.X.X con la IP real del PC servidor
# ══════════════════════════════════════════════════════

# ── Base de datos (SQLite local en el servidor) ───────
DATABASE_URL=sqlite+aiosqlite:///./superozono.db
REDIS_URL=redis://localhost:6379/0

# ── Seguridad ─────────────────────────────────────────
# Genera una clave nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERA_UNA_CLAVE_SEGURA_AQUI
ACCESS_TOKEN_EXPIRE_HOURS=1
REFRESH_TOKEN_EXPIRE_DAYS=30
DEBUG=false

# ── CORS — debe incluir la IP del servidor para que los 4 PCs cliente conecten ──
CORS_ORIGINS=http://192.168.X.X:5173,http://localhost:5173

# ── Empresa ───────────────────────────────────────────
EMPRESA_NIT=901841798-5
EMPRESA_RAZON_SOCIAL=TECNOLOGIA E INNOVACION SUPER OZONO S.A.S.
EMPRESA_CIUDAD=Armenia, Quindio
