# ══════════════════════════════════════════════════════
# Lanxa ERP — Plantilla de variables
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env real a git
# ══════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=superozono
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=superozono_erp

# ── Backend (FastAPI) ─────────────────────────────────
# Docker:  postgresql+asyncpg://superozono:PASSWORD@db:5432/superozono_erp
# Local:   sqlite+aiosqlite:///./superozono.db  (soportado — despliegue LAN v0.3.0)
DATABASE_URL=postgresql+asyncpg://superozono:CAMBIA_ESTA_CONTRASENA@db:5432/superozono_erp
REDIS_URL=redis://redis:6379/0

# Tests/dev: la suite corre contra PostgreSQL (no SQLite). Ver ops/TESTES-LOCAL-POSTGRES.md
# y ops/run-tests.ps1. Crear BD: CREATE DATABASE superozono_test;
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/superozono_test

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# Minimo 32 caracteres, recomendado 64
SECRET_KEY=GENERA_UNA_CLAVE_SEGURA_AQUI
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DEBUG=false

# ── CORS ───────────────────────────────────────────────
# Origenes permitidos separados por coma. NUNCA usar "*" en produccion
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Empresa ───────────────────────────────────────────
EMPRESA_NIT=
EMPRESA_RAZON_SOCIAL=LANXA S.A.S.
EMPRESA_CIUDAD=

# ── Tributario ────────────────────────────────────────
# UVT 2026 (DIAN Res. 000238/2025). Tope retefuente compras generales en UVT.
UVT_VALOR=52374
RETEFUENTE_BASE_UVT=27
# half_even (default, Python) | half_up (comercial al 0.5) — lo decide el Contador (#24)
RETENCION_REDONDEO=half_even

# ── Resolución DIAN (#22) — rellenar con numeración autorizada ──
DIAN_RESOLUCION_NUMERO=
DIAN_RESOLUCION_FECHA=
DIAN_PREFIJO=
DIAN_RANGO_DESDE=
DIAN_RANGO_HASTA=
DIAN_VIGENCIA_HASTA=

# ── Habeas Data (#23) — texto corto pie de factura / UI ──
# HABEAS_DATA_TEXTO=El titular autoriza...

# ── pgAdmin ───────────────────────────────────────────
PGADMIN_EMAIL=tu_email@ejemplo.com
PGADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA

# ── Alegra (facturacion electronica) ──────────────────
# Obtener en: Alegra > Configuracion > API > Token
ALEGRA_EMAIL=tu_email@alegra.com
ALEGRA_TOKEN=TU_TOKEN_DE_ALEGRA_AQUI

# ── Mantenimiento / Auditoria ─────────────────────────
# Dias a conservar en el log de auditoria antes de archivar+purgar (#28).
# 1825 ≈ 5 anios. El archivado reusa BACKUP_ENCRYPTION_KEY y BACKUP_DIR
# (deben estar definidos para que scripts/purge_auditoria.py pueda cifrar).
AUDITORIA_RETENTION_DAYS=1825

# ── Datos DEMO ────────────────────────────────────────
# false (por defecto): el arranque siembra SOLO la config esencial (PUC,
# parametros, admin) — el inventario queda vacio para cargar datos reales.
# true: ademas siembra productos/clientes de ejemplo. Usar solo en demos.
SEED_DEMO=false
