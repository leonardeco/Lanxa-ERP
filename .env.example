# ══════════════════════════════════════════════════════
# Super Ozono Global ERP — Plantilla de variables
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env real a git
# ══════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=superozono
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=superozono_erp

# ── Backend (FastAPI) ─────────────────────────────────
# Docker:  postgresql+asyncpg://superozono:PASSWORD@db:5432/superozono_erp
# Local:   sqlite+aiosqlite:///./superozono.db
DATABASE_URL=postgresql+asyncpg://superozono:CAMBIA_ESTA_CONTRASENA@db:5432/superozono_erp
REDIS_URL=redis://redis:6379/0

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERA_UNA_CLAVE_SEGURA_AQUI
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=30
DEBUG=false

# ── Empresa ───────────────────────────────────────────
EMPRESA_NIT=901841798-5
EMPRESA_RAZON_SOCIAL=TECNOLOGIA E INNOVACION SUPER OZONO S.A.S.
EMPRESA_CIUDAD=Armenia, Quindio

# ── pgAdmin ───────────────────────────────────────────
PGADMIN_EMAIL=tu_email@ejemplo.com
PGADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA

# ── Alegra (facturacion electronica) ──────────────────
# Obtener en: Alegra > Configuracion > API > Token
ALEGRA_EMAIL=tu_email@alegra.com
ALEGRA_TOKEN=TU_TOKEN_DE_ALEGRA_AQUI
