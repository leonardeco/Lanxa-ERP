# ══════════════════════════════════════════════════════════
# Super Ozono Global ERP — Producción (PC Servidor)
# INSTRUCCIONES: copiar este archivo como .env en la raíz
#   cp .env.produccion .env
# ══════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=superozono
POSTGRES_PASSWORD=CambiarEstaContrasena2026!
POSTGRES_DB=superozono_erp

# ── Base de datos (backend usa esta URL) ──────────────────
DATABASE_URL=postgresql+asyncpg://superozono:CambiarEstaContrasena2026!@db:5432/superozono_erp

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Seguridad — CAMBIAR antes de producción ───────────────
SECRET_KEY=cambiar-por-clave-aleatoria-larga-minimo-64-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DEBUG=false

# ── CORS — con nginx proxy no aplica al frontend ──────────
# Solo necesario si se accede a /docs directamente por IP
CORS_ORIGINS=http://localhost

# ── Empresa ───────────────────────────────────────────────
EMPRESA_NIT=901841798-5
EMPRESA_RAZON_SOCIAL=TECNOLOGIA E INNOVACION SUPER OZONO S.A.S.
EMPRESA_CIUDAD=Armenia, Quindio

# ── pgAdmin ───────────────────────────────────────────────
PGADMIN_EMAIL=admin@superozonoglobal.com
PGADMIN_PASSWORD=CambiarEstaContrasena2026!

# ── Alegra (facturación electrónica — opcional) ───────────
ALEGRA_EMAIL=
ALEGRA_TOKEN=

# ── Mantenimiento / Auditoría ─────────────────────────────
# Días a conservar en el log de auditoría antes de archivar+purgar (#28).
# 1825 ≈ 5 años. El archivado reusa BACKUP_ENCRYPTION_KEY y BACKUP_DIR
# (deben estar definidos para que scripts/purge_auditoria.py pueda cifrar).
AUDITORIA_RETENTION_DAYS=1825
