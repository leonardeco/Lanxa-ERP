# Copiar a .env.docker (NO subir a git) para docker-compose.prod.yml
#   copy .env.docker.example .env.docker

IMAGE_TAG=latest
FRONTEND_PORT=80
BACKEND_PORT=8000

# Vacío = frontend usa /api del mismo origen (nginx → backend)
VITE_API_URL=

POSTGRES_USER=superozono
POSTGRES_PASSWORD=CAMBIA_PASSWORD_DB_FUERTE
POSTGRES_DB=superozono_erp

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERA_UNA_CLAVE_DE_64_HEX

DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Orígenes del navegador (coma). Con nginx en :80:
CORS_ORIGINS=http://localhost,http://127.0.0.1

SEED_ADMIN_EMAIL=admin@superozonoglobal.com
# Obligatorio con DEBUG=false — NO uses Admin2026!
SEED_ADMIN_PASSWORD=CAMBIA_CLAVE_ADMIN_FUERTE

EMPRESA_NIT=901841798-5
EMPRESA_RAZON_SOCIAL=TECNOLOGIA E INNOVACION SUPER OZONO S.A.S.
EMPRESA_CIUDAD=Armenia, Quindio
SEED_DEMO=false
